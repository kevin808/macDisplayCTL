#!/bin/sh
set -eu
task_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ "${1-}" = guard ]; then
    shift
    exec "$task_dir/macDisplayCtl-guard" "$@"
fi
task_binary="$task_dir/build/macDisplayCtl"
if [ ! -x "$task_binary" ] || [ "$task_dir/macDisplayCtl.m" -nt "$task_binary" ]; then
    mkdir -p "$task_dir/build"
    xcrun clang -mmacosx-version-min=13.0 -fobjc-arc -O2 -Wall -Wextra \
        -framework Foundation -framework CoreGraphics -framework IOKit \
        "$task_dir/macDisplayCtl.m" -o "$task_binary"
fi
exec "$task_binary" "$@"
