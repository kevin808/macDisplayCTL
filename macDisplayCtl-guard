#!/bin/sh
set -eu
task_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
task_support="$HOME/Library/Application Support/macDisplayCtl"
task_plist="$HOME/Library/LaunchAgents/local.macDisplayCtl.guard.plist"
task_domain="gui/$(id -u)"
task_label="local.macDisplayCtl.guard"
task_service="$task_domain/$task_label"
task_log="$HOME/Library/Logs/macDisplayCtl-guard.log"
MACDISPLAYCTL_LANGUAGE=$("$task_dir/macDisplayCtl" language)
export MACDISPLAYCTL_LANGUAGE
message() {
    task_chinese=$1
    task_english=$2
    shift 2
    if [ "$MACDISPLAYCTL_LANGUAGE" = zh-Hans ]; then
        printf "$task_chinese" "$@"
    else
        printf "$task_english" "$@"
    fi
}
if [ "$#" -gt 1 ]; then
    message '用法：macDisplayCtl guard start|stop|status\n' 'Usage: macDisplayCtl guard start|stop|status\n' >&2
    exit 2
fi
case "${1-status}" in
    start)
        # Build and validate read-only before changing the installed service.
        "$task_dir/macDisplayCtl" watch --dry-run --once >/dev/null
        mkdir -p "$task_support" "$HOME/Library/LaunchAgents" "$HOME/Library/Logs"
        if [ -f "$task_plist" ]; then
            cp "$task_plist" "$task_plist.backup"
        fi
        if [ -f "$task_support/macDisplayCtl" ]; then
            cp "$task_support/macDisplayCtl" "$task_support/macDisplayCtl.backup"
        fi
        if [ -f "$task_dir/build/macDisplayCtl" ]; then
            cp "$task_dir/build/macDisplayCtl" "$task_support/macDisplayCtl.new"
        else
            # A packaged .app ships the compiled helper alongside this script.
            cp "$task_dir/macDisplayCtl" "$task_support/macDisplayCtl.new"
        fi
        chmod 755 "$task_support/macDisplayCtl.new"
        mv "$task_support/macDisplayCtl.new" "$task_support/macDisplayCtl"
        # plutil is included with macOS; it safely escapes paths in the plist.
        task_new_plist="$task_plist.new"
        (umask 077; /usr/bin/plutil -create xml1 "$task_new_plist")
        /usr/bin/plutil -insert Label -string "$task_label" "$task_new_plist"
        /usr/bin/plutil -insert AssociatedBundleIdentifiers -array "$task_new_plist"
        /usr/bin/plutil -insert AssociatedBundleIdentifiers.0 -string com.github.kevin808.macDisplayCtl "$task_new_plist"
        /usr/bin/plutil -insert ProgramArguments -array "$task_new_plist"
        /usr/bin/plutil -insert ProgramArguments.0 -string "$task_support/macDisplayCtl" "$task_new_plist"
        /usr/bin/plutil -insert ProgramArguments.1 -string watch "$task_new_plist"
        /usr/bin/plutil -insert RunAtLoad -bool YES "$task_new_plist"
        /usr/bin/plutil -insert KeepAlive -bool YES "$task_new_plist"
        /usr/bin/plutil -insert ProcessType -string Background "$task_new_plist"
        /usr/bin/plutil -insert LimitLoadToSessionType -string Aqua "$task_new_plist"
        /usr/bin/plutil -insert ThrottleInterval -integer 30 "$task_new_plist"
        /usr/bin/plutil -insert StandardOutPath -string "$task_log" "$task_new_plist"
        /usr/bin/plutil -insert StandardErrorPath -string "$task_log" "$task_new_plist"
        chmod 600 "$task_new_plist"
        /usr/bin/plutil -lint "$task_new_plist" >/dev/null
        mv "$task_new_plist" "$task_plist"
        plutil -lint "$task_plist" >/dev/null
        if launchctl print "$task_service" >/dev/null 2>&1; then
            launchctl bootout "$task_service"
        fi
        # bootout may return before the previous watcher has released its lock.
        "$task_support/macDisplayCtl" --wait-guard-lock "$task_support/guard.lock"
        launchctl enable "$task_service"
        launchctl bootstrap "$task_domain" "$task_plist"
        message '断开外屏后自动点亮内屏已启用，并设为登录时启动。\n日志：%s\n' 'Automatic built-in screen recovery after external disconnection enabled, with launch at login.\nLog: %s\n' "$task_log"
        ;;
    stop)
        launchctl disable "$task_service"
        if launchctl print "$task_service" >/dev/null 2>&1; then
            launchctl bootout "$task_service"
        fi
        message '兜底监控已停止，登录自动启动也已关闭。屏幕状态保持不变。\n' 'Monitor stopped and launch at login disabled. Display state is unchanged.\n'
        ;;
    status)
        task_output=$(launchctl print "$task_service" 2>/dev/null) || {
            message '兜底监控未运行。启用：macDisplayCtl guard start\n' 'Monitor is not running. Enable with: macDisplayCtl guard start\n'
            exit 0
        }
        printf '%s\n' "$task_output" | /usr/bin/awk '/state =|pid =|last exit code =/ {print}'
        message '日志：%s\n' 'Log: %s\n' "$task_log"
        ;;
    *) message '用法：macDisplayCtl guard start|stop|status\n' 'Usage: macDisplayCtl guard start|stop|status\n' >&2; exit 2 ;;
esac
